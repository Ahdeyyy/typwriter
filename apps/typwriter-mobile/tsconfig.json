{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "sourceMap": true,
    "strict": true,
    // TypeScript 6 no longer loads every @types package by default; the
    // co-located *.test.ts files need bun:test and the Bun global.
    "types": ["$app/types", "bun"]
  },
  // `$app/tsconfig` sets no include/exclude of its own.
  "include": ["src", "vite.config.ts"]
}
