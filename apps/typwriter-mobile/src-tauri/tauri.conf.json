{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typwriter",
  "version": "0.9.2",
  "identifier": "com.ahdey.typwriter.mobile",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [{ "title": "Typwriter", "width": 420, "height": 860 }],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' previewimg: http://previewimg.localhost data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      {
        "ext": ["typ"],
        "name": "Typst document",
        "mimeType": "text/vnd.typst",
        "role": "Editor",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["typ"],
        "name": "Typst document",
        "mimeType": "text/plain",
        "role": "Editor",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["typ"],
        "name": "Typst document",
        "mimeType": "application/octet-stream",
        "role": "Editor",
        "androidIntentActionFilters": ["view"]
      }
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
