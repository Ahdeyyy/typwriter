<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed 108dp layer: the launcher's mask (circle, squircle, rounded
     square, teardrop...) is the tile's shape, so no corners are drawn here. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <path android:pathData="M0,0H108V108H0Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="90"
          android:startY="18"
          android:endX="18"
          android:endY="90"
          android:startColor="#FF0A0A0A"
          android:endColor="#FF3C3C3C"/>
    </aapt:attr>
  </path>
</vector>
