{
  "name": "typwriter-mobile",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "bun run licenses:check && vite build",
    "icons": "tauri icon app-icon.png && bun scripts/android-icon.ts",
    "icons:nightly": "tauri icon app-icon-nightly.png && bun scripts/android-icon.ts nightly",
    "licenses:generate": "bun scripts/generate-licenses.ts",
    "licenses:check": "bun scripts/generate-licenses.ts --check",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check-types": "bun run check",
    "lint": "eslint .",
    "test": "bun test",
    "test:state": "bun test --conditions=browser --preload ../../scripts/register-svelte-runes.ts ../../tests/frontend-state/mobile.regression.ts && bun test --conditions=browser --preload ../../scripts/register-svelte-runes.ts ../../tests/frontend-state/mobile-lifecycle.regression.ts && bun test --conditions=browser --preload ../../scripts/register-svelte-runes.ts ../../tests/frontend-state/mobile-document-opening.regression.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/svelte": "^1.1.5",
    "@lezer/common": "^1.5.6",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-log": "^2.10.2",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-store": "^2.5.1",
    "neverthrow": "^8.2.0",
    "runed": "^0.38.0",
    "vaul-svelte": "^1.0.0-next.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/load-config": "^0.2.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/bun": "^1.4.5",
    "bits-ui": "^2.22.0",
    "clsx": "^2.1.1",
    "codemirror-typst": "^0.1.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^1.8.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  }
}
