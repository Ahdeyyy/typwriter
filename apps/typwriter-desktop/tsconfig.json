{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "sourceMap": true,
    "strict": true
  },
  // `$app/tsconfig` sets no include/exclude of its own.
  "include": ["src", "tests", "vite.config.js"],
  "exclude": [
    // `bun test` runs these; svelte-check has no `bun:test` types to resolve.
    "src/**/*.test.ts"
  ]
}
