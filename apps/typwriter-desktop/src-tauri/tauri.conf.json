{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typwriter",
  "version": "0.9.3",
  "identifier": "com.ahdey.typwriter",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Typwriter",
        "width": 1200,
        "height": 640,
        "minWidth": 1200,
        "minHeight": 640,
        "maximized": true,
        "dragDropEnabled": false,
        "decorations": false,
        "titleBarStyle": "Transparent",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost previewimg: http://previewimg.localhost data: blob:; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["typ"],
        "name": "Typst document",
        "description": "Typst source document",
        "role": "Editor",
        "mimeType": "text/vnd.typst"
      }
    ],
    "resources": {
      "./assets/fonts/": "fonts/"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/typwriter.desktop",
        "depends": ["shared-mime-info", "desktop-file-utils"],
        "files": {
          "/usr/share/mime/packages/com.ahdey.typwriter.xml": "linux/com.ahdey.typwriter.xml"
        },
        "postInstallScript": "linux/update-desktop-databases.sh",
        "postRemoveScript": "linux/update-desktop-databases.sh"
      },
      "rpm": {
        "desktopTemplate": "linux/typwriter.desktop",
        "depends": ["shared-mime-info", "desktop-file-utils"],
        "files": {
          "/usr/share/mime/packages/com.ahdey.typwriter.xml": "linux/com.ahdey.typwriter.xml"
        },
        "postInstallScript": "linux/update-desktop-databases.sh",
        "postRemoveScript": "linux/update-desktop-databases.sh"
      },
      "appimage": {
        "files": {
          "/usr/share/mime/packages/com.ahdey.typwriter.xml": "linux/com.ahdey.typwriter.xml"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxRThFQTIzRDY5OTVDQkYKUldTL1hKbldJK3JvTWRjL2RVcDl0R2g4VUd2eDN1Z0hnSUFUN0lndHB6RlBDVEN3NmJZbW1SUk8K",
      "endpoints": [
        "https://github.com/ahdeyyy/typwriter/releases/latest/download/latest.json"
      ]
    }
  }
}
