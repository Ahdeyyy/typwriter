{
  "name": "typwriter",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.17"
  },
  "packageManager": "bun@1.3.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@fontsource/iosevka": "^5.3.0",
    "mode-watcher": "^1.1.0"
  },
  "overrides": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@codemirror/lint": "6.9.8",
    "@codemirror/language": "6.13.1",
    "@lezer/common": "1.5.6",
    "@lezer/highlight": "1.2.5"
  }
}
